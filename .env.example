# Mundo Burguer — variables de entorno

# URL pública del sitio (para canonical, Open Graph y sitemap).
VITE_SITE_URL=https://www.mundoburguer.es

# Measurement ID de Google Analytics 4 (formato "G-XXXXXXX").
# Déjala vacía para no cargar Google Analytics. Solo se carga en el navegador
# si, además, la persona visitante acepta la categoría "Análisis" del banner
# de cookies (ver src/lib/cookieConsent.tsx).
VITE_GA_MEASUREMENT_ID=

# ── Backend (Supabase) ──────────────────────────────────────────────────────
# Necesarias para el panel privado (/panel) y para que la carta pública lea de
# la base de datos. Sin ellas la web sigue funcionando: la carta usa su
# snapshot estático y el panel queda inaccesible.
#
# Ambas son PÚBLICAS (viajan en el bundle del navegador). La seguridad NO
# depende de que sean secretas, sino de las políticas RLS de Postgres.
VITE_SUPABASE_URL=https://<REF>.supabase.co
VITE_SUPABASE_ANON_KEY=

# La clave service_role NO va aquí ni en Vercel: es solo para el seed inicial
# desde tu máquina. Ponla en .env.local (ignorado por git). Ver README.
# SUPABASE_SERVICE_ROLE_KEY=
